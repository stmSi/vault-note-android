<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VaultNote.DarkBase" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="vaultPinActiveColor">#8FC1FF</item>
        <item name="vaultFavoriteActiveColor">#FFB951</item>
    </style>

    <style name="Theme.VaultNote" parent="Theme.VaultNote.Dark" />

    <style name="Theme.VaultNote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111318</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_vaultnote_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.VaultNote.Dark</item>
    </style>
</resources>
